NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# PostgreSQL
DATABASE_URL=postgresql://zapformat:CHANGE_ME@127.0.0.1:5432/zapformat
PGSSL=false

# Public frontend origins, comma separated.
# Add the GitHub Pages origin now; replace/add the production domain later.
FRONTEND_ORIGINS=https://korrestconsult.github.io

# Cookie settings.
COOKIE_NAME=zf_session
COOKIE_DOMAIN=
COOKIE_SAME_SITE=none
SESSION_DAYS=30

# Phone verification and password recovery.
# SMS.RU API key from https://sms.ru (keep server-side only).
SMSRU_API_ID=
# Optional approved sender name. Leave empty to use the provider default.
SMSRU_FROM=
# Set true only with an SMS.RU test account/key.
SMSRU_TEST=false
# Dedicated HMAC secret for one-time-code hashes. If empty, INTERNAL_API_TOKEN is used.
AUTH_OTP_SECRET=

# PartGrade uses the ABCP public API. Credentials belong only on the backend.
# API host confirmed by PartGrade on 2026-09-25.
PARTGRADE_API_BASE=https://auto-complekt.public.api.abcp.ru
PARTGRADE_API_LOGIN=
# ABCP expects the MD5 hash of the PartGrade site password, not the plaintext password.
PARTGRADE_API_PASSWORD_MD5=
PARTGRADE_API_TIMEOUT_MS=12000

# Optional dedicated key for opaque cart offer tokens.
# If empty, backend falls back to INTERNAL_API_TOKEN or the existing PartGrade MD5 credential.
OFFER_TOKEN_SECRET=

# Pricing
DEFAULT_MARKUP_PERCENT=15
MIN_MARKUP_RUB=0


# Timeweb Cloud MCP
# Store the dedicated API token only on the server, never in frontend/plugin files.
TIMEWEB_CLOUD_TOKEN=
