NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# PostgreSQL
DATABASE_URL=postgresql://zapformat:CHANGE_ME@127.0.0.1:5432/zapformat
PGSSL=false

# Public frontend origins, comma separated.
# Add the GitHub Pages origin now; replace/add the production domain later.
FRONTEND_ORIGINS=https://korrestconsult.github.io

# Cookie settings.
COOKIE_NAME=zf_session
COOKIE_DOMAIN=
COOKIE_SAME_SITE=none
SESSION_DAYS=30

# PartGrade uses the ABCP public API. Credentials belong only on the backend.
# API host confirmed by PartGrade on 2026-09-25.
PARTGRADE_API_BASE=https://auto-complekt.public.api.abcp.ru
PARTGRADE_API_LOGIN=
# ABCP expects the MD5 hash of the PartGrade site password, not the plaintext password.
PARTGRADE_API_PASSWORD_MD5=
PARTGRADE_API_TIMEOUT_MS=12000

# Pricing
DEFAULT_MARKUP_PERCENT=15
MIN_MARKUP_RUB=0
