NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# PostgreSQL
DATABASE_URL=postgresql://zapformat:CHANGE_ME@127.0.0.1:5432/zapformat
PGSSL=false

# Public frontend origins, comma separated.
# Add the GitHub Pages origin now; replace/add the production domain later.
FRONTEND_ORIGINS=https://korrestconsult.github.io

# Cookie settings.
COOKIE_NAME=zf_session
COOKIE_DOMAIN=
COOKIE_SAME_SITE=none
SESSION_DAYS=30

# Supplier secrets belong only on the backend and must never be committed.
PARTGRADE_API_BASE=
PARTGRADE_API_KEY=
PARTGRADE_CLIENT_ID=
PARTGRADE_CLIENT_SECRET=

# Pricing
DEFAULT_MARKUP_PERCENT=15
