NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# PostgreSQL
DATABASE_URL=postgresql://zapformat:CHANGE_ME@127.0.0.1:5432/zapformat
PGSSL=false

# Public frontend origins, comma separated.
# Same-origin production can leave this empty. Add an explicit origin only for a separate trusted frontend.
FRONTEND_ORIGINS=

# Cookie settings.
COOKIE_NAME=zf_session
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
SESSION_DAYS=30

# PartGrade uses the ABCP public API. Credentials belong only on the backend.
# API host confirmed by PartGrade on 2026-09-25.
PARTGRADE_API_BASE=https://auto-complekt.public.api.abcp.ru
PARTGRADE_API_LOGIN=
# ABCP expects the MD5 hash of the PartGrade site password, not the plaintext password.
PARTGRADE_API_PASSWORD_MD5=
PARTGRADE_API_TIMEOUT_MS=12000

# Pricing
DEFAULT_MARKUP_PERCENT=15
MIN_MARKUP_RUB=0


# OpenAI AI search layer. Keep the key only on the VPS backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=12000
AI_SEARCH_HOURLY_LIMIT=60


# Public supplier-search protection
CATALOG_SEARCH_10M_LIMIT=240
